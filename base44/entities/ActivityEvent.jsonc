{
  "name": "ActivityEvent",
  "type": "object",
  "properties": {
    "event_type": {
      "type": "string",
      "enum": [
        "list",
        "sale",
        "bid",
        "transfer",
        "mint"
      ]
    },
    "nft_id": {
      "type": "string"
    },
    "collection_id": {
      "type": "string"
    },
    "from_user_id": {
      "type": "string"
    },
    "to_user_id": {
      "type": "string"
    },
    "tx_hash": {
      "type": "string"
    },
    "price": {
      "type": "number"
    },
    "currency": {
      "type": "string",
      "default": "ETH"
    }
  },
  "required": [
    "event_type",
    "nft_id"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}