{
  "name": "WorldState",
  "type": "object",
  "description": "Per-user per-world persistent state (discovered locations, owned properties, last position).",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "world_id": {
      "type": "string",
      "default": "block_001"
    },
    "position": {
      "type": "object",
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "z": {
          "type": "number"
        }
      }
    },
    "rotation": {
      "type": "number",
      "default": 0
    },
    "unlocked_locations": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "discovered_locations": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "owned_properties": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "last_saved_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "user_id",
    "world_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "data.user_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}