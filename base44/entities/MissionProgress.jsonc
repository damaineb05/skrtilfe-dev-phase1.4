{
  "name": "MissionProgress",
  "type": "object",
  "description": "Per-user mission progress inside SKRTLIFE WORLD.",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "mission_id": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "locked",
        "active",
        "completed",
        "claimed"
      ],
      "default": "active"
    },
    "progress": {
      "type": "number",
      "default": 0,
      "description": "0-100"
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "user_id",
    "mission_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "data.user_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}