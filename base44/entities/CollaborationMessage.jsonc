{
  "name": "CollaborationMessage",
  "type": "object",
  "properties": {
    "session_id": {
      "type": "string",
      "description": "ID of the collaboration session"
    },
    "sender_email": {
      "type": "string",
      "description": "Email of the message sender"
    },
    "sender_name": {
      "type": "string",
      "description": "Name of the sender"
    },
    "message_type": {
      "type": "string",
      "enum": [
        "text",
        "system",
        "action",
        "mention"
      ],
      "default": "text"
    },
    "content": {
      "type": "string",
      "description": "Message content"
    },
    "mentions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Array of mentioned user emails"
    },
    "action_data": {
      "type": "object",
      "description": "Data for action messages (object moved, etc.)"
    },
    "is_read": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "session_id",
    "sender_email",
    "content"
  ],
  "rls": {
    "read": {},
    "create": {
      "data.sender_email": "{{user.email}}"
    },
    "update": {
      "$or": [
        {
          "data.sender_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.sender_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}