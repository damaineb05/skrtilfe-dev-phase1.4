{
  "name": "Profile",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "format": "email",
      "description": "Email of the user this profile belongs to"
    },
    "username": {
      "type": "string",
      "description": "Unique handle/username"
    },
    "display_name": {
      "type": "string",
      "description": "Display name shown publicly"
    },
    "avatar_url": {
      "type": "string",
      "description": "Profile photo URL"
    },
    "bio": {
      "type": "string",
      "description": "Short bio"
    },
    "extended_bio": {
      "type": "string",
      "description": "Longer extended bio"
    },
    "location": {
      "type": "string",
      "description": "City, Country"
    },
    "website": {
      "type": "string",
      "description": "Personal website URL"
    },
    "social_links": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "platform": {
            "type": "string"
          },
          "url": {
            "type": "string"
          }
        }
      }
    },
    "membership_tier": {
      "type": "string",
      "enum": [
        "basic",
        "genesis"
      ],
      "default": "basic",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "reputation_score": {
      "type": "integer",
      "default": 0,
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "badges": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "shipping_addresses": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "full_name": {
            "type": "string"
          },
          "phone": {
            "type": "string"
          },
          "line1": {
            "type": "string"
          },
          "line2": {
            "type": "string"
          },
          "city": {
            "type": "string"
          },
          "state": {
            "type": "string"
          },
          "zip": {
            "type": "string"
          },
          "country": {
            "type": "string"
          },
          "is_default": {
            "type": "boolean",
            "default": false
          }
        }
      }
    },
    "billing_address": {
      "type": "object",
      "properties": {
        "use_shipping": {
          "type": "boolean",
          "default": true
        },
        "full_name": {
          "type": "string"
        },
        "line1": {
          "type": "string"
        },
        "line2": {
          "type": "string"
        },
        "city": {
          "type": "string"
        },
        "state": {
          "type": "string"
        },
        "zip": {
          "type": "string"
        },
        "country": {
          "type": "string"
        }
      }
    },
    "forum_stats": {
      "type": "object",
      "properties": {
        "posts_count": {
          "type": "integer",
          "default": 0
        },
        "replies_count": {
          "type": "integer",
          "default": 0
        },
        "upvotes_received": {
          "type": "integer",
          "default": 0
        }
      }
    },
    "perks": {
      "type": "object",
      "properties": {
        "early_access": {
          "type": "boolean",
          "default": false
        },
        "exclusive_drops": {
          "type": "boolean",
          "default": false
        },
        "priority_checkout": {
          "type": "boolean",
          "default": false
        },
        "private_forums": {
          "type": "boolean",
          "default": false
        },
        "discounted_shipping": {
          "type": "boolean",
          "default": false
        },
        "members_only_pricing": {
          "type": "boolean",
          "default": false
        }
      },
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    }
  },
  "required": [
    "user_email"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "data.user_email": "{{user.email}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}
