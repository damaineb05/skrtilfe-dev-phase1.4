{
  "name": "RoomLayout",
  "type": "object",
  "description": "Canonical persistent layout for a user's DripSync room. Writes must go through saveRoomLayout so asset ids and ownership are validated server-side.",
  "properties": {
    "user_id": { "type": "string" },
    "room_id": { "type": "string" },
    "schema_version": { "type": "integer", "default": 1 },
    "room_template": { "type": "string" },
    "environment": { "type": "string" },
    "lighting_preset": { "type": "string" },
    "objects": { "type": "array", "items": { "type": "object" } }
  },
  "required": ["user_id", "room_id", "schema_version", "room_template", "objects"],
  "rls": {
    "read": { "$or": [{ "data.user_id": "{{user.id}}" }, { "user_condition": { "role": "admin" } }] },
    "create": { "user_condition": { "role": "admin" } },
    "update": { "user_condition": { "role": "admin" } },
    "delete": { "user_condition": { "role": "admin" } }
  }
}

